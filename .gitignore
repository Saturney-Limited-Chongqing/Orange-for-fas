# Generated files (build_runner, freezed, etc.)
*.g.dart
*.freezed.dart
# 生成文件已提交入库，保证全新 clone 无需本机跑 build_runner 即可构建
!lib/models/generated/**
!lib/providers/generated/**
!lib/xboard/adapter/state/generated/**
!lib/xboard/adapter/initialization/generated/**
!lib/xboard/domain/models/generated/**
!lib/xboard/features/initialization/models/generated/**

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release



#libclash
/libclash/

#jniLibs
/android/app/src/main/jniLibs/

# Android CXX build artifacts
/android/core/.cxx/

# XBoard 配置文件（用户自定义，不提交）
# 只忽略根目录的配置文件，assets/config/ 下的要提交
/xboard.config.yaml
/xboard.config.yml
assets/config/xboard.config.yaml

# 忽略证书文件
assets/cer/
!assets/cer/.gitkeep
